    "clean": "rimraf dist",
    "prepublishOnly": "pnpm clean && pnpm test run && pnpm build",
    "test": "vitest"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "payload": "3.88.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
