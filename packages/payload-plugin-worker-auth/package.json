{
  "name": "payload-plugin-worker-auth",
  "version": "0.1.0",
  "description": "Payload auth strategy plugin for verifying JWT sessions issued by a shared Cloudflare Worker (magic-link / passwordless admin login)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
